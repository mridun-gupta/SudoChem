digraph ENERGY008_SOLVER {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.30", nodesep="0.18", ranksep="0.26", splines=ortho, fontname="Helvetica", label="ENERGY-008 | PRINCIPAL NONLINEAR SOLVER\nStoichiometry → property / PFR / flash → S-209 recycle → closure / export", labelloc=t, fontsize=19];
  node [shape=box, style="rounded,filled", fillcolor="#F3F6FA", color="#49627A", fontname="Helvetica", fontsize=9, margin="0.13,0.07"];
  edge [color="#50677D", penwidth=1.15, arrowsize=0.7, fontname="Helvetica", fontsize=8];

  START [label="START CASE\nLoad versioned inputs / case ID / design scenario", fillcolor="#E7F0FA"];
  SCHEMA [label="Validate schema, units, dimensions, provenance\nCheck source approvals, data status, bounds and completeness"];
  READY [shape=diamond, label="Required data\ncomplete and valid?", fillcolor="#FFF1CC", color="#A97918"];
  BDATA [label="BLOCK: emit E_DATA_MISSING / E_PROPERTY_BLOCKED\nList missing EOS pairs, kinetics, feed assays, VLE, vendor maps\nNo default values; dependent solver not called", fillcolor="#FCE8E6", color="#B64A42"];
  STOICH [label="Assemble independent stoichiometric matrix\nExact rank, null-space, C/H/O invariants; reject dependent R-03\nDefine extents and component scales", fillcolor="#E9F6F2"];
  EXT [shape=diamond, label="Extents and feed\nphysically admissible?", fillcolor="#FFF1CC", color="#A97918"];
  BEXT [label="FAIL: E_INVALID_EXTENT / E_NEG_FLOW\nKeep signed residual, identify species / reaction / case", fillcolor="#FCE8E6", color="#B64A42"];
  INIT [label="INITIALISE OUTER RECYCLE\nS-209 component vector seed (zero is numerical seed only)\nλ = 0.3; tol = 1e-8; max outer iterations = 500\nStore F-scale per species and iteration log", fillcolor="#E7F0FA"];
  FRONT [label="SEQUENTIAL FRONT-END / ALK MODELS\nCO2 conditioning component balances + K-101 state\nW-201 quality + ELY Faraday/vendor map + D-201/K-201\nReject out-of-map or crossover / quality-invalid states", fillcolor="#E9F6F2"];
  MIX [label="M-301 / HX-301 FEED STATE\nCombine fresh CO2 + H2 + S-209 recycle\nEvaluate feed composition, enthalpy and valid preheat state", fillcolor="#E9F6F2"];
  EOS [label="PROPERTY CALL: PR78 / SRK CHECK\nEOS roots + phase stability + phi_i + fugacity\nRequire all active kij and phase/temperature/pressure validity", fillcolor="#E9F6F2"];
  EOSOK [shape=diamond, label="Property state\nvalid / stable?", fillcolor="#FFF1CC", color="#A97918"];
  EPROP [label="FAIL/BLOCK: E_EOS_KIJ_MISSING / E_PHASE_STABILITY\nDo not assume kij=0 or ideal gas; preserve last valid state", fillcolor="#FCE8E6", color="#B64A42"];
  KIN [label="LOCAL KINETIC / SITE EQUATIONS\nSource-matched LHHW form and original pressure basis\nSolve site fractions; check [0,1], site sums and rate units", fillcolor="#E9F6F2"];
  KINOK [shape=diamond, label="Kinetics / site\nsolve admissible?", fillcolor="#FFF1CC", color="#A97918"];
  EKIN [label="FAIL: E_KINETICS_UNMATCHED / E_LOCAL_SOLVE\nCatalyst or parameter mismatch; no generic kinetic substitution", fillcolor="#FCE8E6", color="#B64A42"];
  PFR [label="INTEGRATE R-301 PFR IN Wcat\nBDF/Radau adaptive stiff IVP\ndFi/dWcat = Σ nu_ij r_j\nd[Σ Fi hi]/dWcat = -q_removed'\nErgun only with geometry / transport inputs", fillcolor="#E9F6F2"];
  PFRCHK [shape=diamond, label="PFR success + independent\npositivity / range / step-refinement tests?", fillcolor="#FFF1CC", color="#A97918"];
  EPFR [label="FAIL: E_PFR_FAIL / E_NONPHYSICAL_STATE\nRecord axial location, local residuals and rejected step", fillcolor="#FCE8E6", color="#B64A42"];
  FLASH [label="E-302 / V-301 EOS FLASH\nComponent balances + fugacity equality + normalisation\nEnergy balance + stability / phase fraction check", fillcolor="#E9F6F2"];
  FOK [shape=diamond, label="Flash residuals and\nphase tests pass?", fillcolor="#FFF1CC", color="#A97918"];
  EFLASH [label="FAIL: E_FLASH_FAIL\nDo not force vapour fraction or invent liquid split", fillcolor="#FCE8E6", color="#B64A42"];
  SPLIT [label="SPLIT / PURGE / RECYCLE\nSolve purge from measured inert ingress + approved loop cap\nCompress recycle K-301 using valid map; calculate new S-209 vector", fillcolor="#E9F6F2"];
  RESID [label="OUTER S-209 RESIDUAL\nr = max_i |G_i(Rk)-Rk_i| / max(|G_i|, Fscale_i, eps)\nAlso calculate component, elemental and pressure residuals", fillcolor="#E7F0FA"];
  CONV [shape=diamond, label="rS209 ≤ 1e-8\nand all unit / bounds checks pass?", fillcolor="#FFF1CC", color="#A97918"];
  MORE [shape=diamond, label="Iteration < 500\nand residual trend admissible?", fillcolor="#FFF1CC", color="#A97918"];
  RELAX [label="UNDER-RELAX UPDATE\nRk+1 = Rk + λ(G(Rk)-Rk)\nRetain raw/mapped/relaxed vector and every residual\nλ changes only under logged recovery rule", fillcolor="#E7F0FA"];
  RETRY [label="RECOVERY BRANCH\nReduce λ or use approved continuation from last admissible point\nOptional Anderson/Newton only in separately tested configuration", fillcolor="#FFF1CC", color="#A97918"];
  EREC [label="FAIL: E_RECYCLE_MAX / E_RECYCLE_DIVERGE\nStatus FAILED; preserve last iterate; suppress converged stream export", fillcolor="#FCE8E6", color="#B64A42"];
  DIST [label="DOWNSTREAM DISTILLATION / MESH\nOnly if Wilson/NRTL data, pressure, feed and product basis valid\nSolve material + equilibrium + summation + energy equations", fillcolor="#E9F6F2"];
  MESHOK [shape=diamond, label="MESH residual / physical\nchecks pass?", fillcolor="#FFF1CC", color="#A97918"];
  EMESH [label="BLOCK/FAIL: E_MESH_FAIL\nPreserve tray/stage diagnostics; no arbitrary reflux or pressure change", fillcolor="#FCE8E6", color="#B64A42"];
  CLOSURE [label="FINAL RECOMPUTE + CLOSURE\nRe-run every unit at accepted tear vector\nComponent / mass / C-H-O / energy / quality / bounds\nNo balancing stream and no heat-reaction double count", fillcolor="#E9F6F2"];
  GATE [shape=diamond, label="All acceptance gates pass?\nMaterial + energy + property + equipment + KPI", fillcolor="#FFF1CC", color="#A97918"];
  ECL [label="FAIL: closure / entropy / exergy / sizing code\nKeep failed status and missing terms; no KPI promotion", fillcolor="#FCE8E6", color="#B64A42"];
  EXPORT [label="EXPORT ACCEPTED CASE\nStream / equipment / utilities / KPI outputs\nVersion + residuals + iterations + uncertainty + audit trail\nMark each result CALCULATED / REFERENCE_ONLY / BLOCKED", fillcolor="#E7F0FA"];
  END [shape=oval, label="END / CASE COMPLETE", fillcolor="#DCEFE2", color="#3F7653"];

  START -> SCHEMA -> READY;
  READY -> STOICH [label="YES"];
  READY -> BDATA [label="NO"];
  STOICH -> EXT;
  EXT -> INIT [label="YES"];
  EXT -> BEXT [label="NO"];
  INIT -> FRONT -> MIX -> EOS -> EOSOK;
  EOSOK -> KIN [label="YES"];
  EOSOK -> EPROP [label="NO"];
  KIN -> KINOK;
  KINOK -> PFR [label="YES"];
  KINOK -> EKIN [label="NO"];
  PFR -> PFRCHK;
  PFRCHK -> FLASH [label="YES"];
  PFRCHK -> EPFR [label="NO"];
  FLASH -> FOK;
  FOK -> SPLIT [label="YES"];
  FOK -> EFLASH [label="NO"];
  SPLIT -> RESID -> CONV;
  CONV -> DIST [label="YES"];
  CONV -> MORE [label="NO"];
  MORE -> RELAX [label="YES"];
  MORE -> RETRY [label="REVIEW"];
  RETRY -> RELAX [style=dashed];
  RETRY -> EREC [label="limits exceeded"];
  RELAX -> FRONT [label="next iteration", style=dashed];
  DIST -> MESHOK;
  MESHOK -> CLOSURE [label="YES"];
  MESHOK -> EMESH [label="NO"];
  CLOSURE -> GATE;
  GATE -> EXPORT [label="YES"];
  GATE -> ECL [label="NO"];
  EXPORT -> END;
  BDATA -> END [style=dashed];
  BEXT -> END [style=dashed];
  EPROP -> END [style=dashed];
  EKIN -> END [style=dashed];
  EPFR -> END [style=dashed];
  EFLASH -> END [style=dashed];
  EREC -> END [style=dashed];
  EMESH -> END [style=dashed];
  ECL -> END [style=dashed];
}
